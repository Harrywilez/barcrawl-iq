# BarCrawl IQ — environment variable template (safe to commit; NO real values here).
# Copy this file to .env.local and fill in your own keys. Never commit .env.local.

# Google Maps Platform API key (server-side use).
GOOGLE_MAPS_API_KEY=

# Supabase project URL (public; exposed to the browser via NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (public; exposed to the browser via NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SECRET; server-side only — never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
